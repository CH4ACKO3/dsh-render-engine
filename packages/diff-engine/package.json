{
  "name": "@ch4acko3/dsh-diff-engine",
  "version": "0.1.0",
  "description": "Normalized diff engine service for DeepSeek Harness Web plugins",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run build:client && pnpm run build:host",
    "build:client": "tsdown --config-loader unrun && tsc -p tsconfig.client.build.json",
    "build:host": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": "^22.22.3 || >=24.11.1"
  },
  "dsh": {
    "plugin": {
      "schemaVersion": 1,
      "displayName": {
        "en": "Diff Engine",
        "zh-CN": "Diff 引擎"
      },
      "summary": {
        "en": "Normalizes file snapshots, DSH file diffs, and unified patches into one structured diff format.",
        "zh-CN": "将文件快照、DSH 文件差异和 unified patch 归一化为统一的结构化 Diff。"
      },
      "category": "development"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.8"
  },
  "dependencies": {
    "diff": "^9.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "diff",
    "unified-diff"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CH4ACKO3/dsh-render-engine.git",
    "directory": "packages/diff-engine"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
