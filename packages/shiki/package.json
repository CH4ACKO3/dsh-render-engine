{
  "name": "@ch4acko3/dsh-shiki",
  "version": "0.1.0",
  "description": "Shared Shiki engine service for DeepSeek Harness Web plugins",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run build:client && pnpm run build:host",
    "build:client": "tsdown --config-loader unrun && tsc -p tsconfig.client.build.json",
    "build:host": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": "^22.22.3 || >=24.11.1"
  },
  "dsh": {
    "plugin": {
      "schemaVersion": 1,
      "displayName": {
        "en": "Shiki Engine",
        "zh-CN": "Shiki 引擎"
      },
      "summary": {
        "en": "A shared Shiki tokenization service for DSH Web plugins.",
        "zh-CN": "为 DSH Web 插件提供共享的 Shiki 代码分词服务。"
      },
      "category": "development"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.8"
  },
  "dependencies": {
    "@shikijs/langs": "^4.3.1",
    "shiki": "^4.3.1"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "shiki",
    "syntax-highlighting"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
