{
  "name": "@ch4acko3/dsh-render-engine-integration",
  "version": "0.1.0",
  "private": true,
  "description": "Browser integration probe for the DSH Render Engine monorepo",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "pnpm run build:client && pnpm run build:host",
    "build:client": "tsdown --config-loader unrun && tsc -p tsconfig.client.build.json",
    "build:host": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js"
  },
  "engines": {
    "node": "^22.22.3 || >=24.11.1"
  },
  "dsh": {
    "plugin": {
      "schemaVersion": 1,
      "displayName": {
        "en": "Render Engine Integration Probe",
        "zh-CN": "渲染引擎集成探针"
      },
      "summary": {
        "en": "Private browser integration probe for DSH Render Engine.",
        "zh-CN": "用于验证 DSH Render Engine 的私有浏览器集成探针。"
      },
      "category": "development"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@ch4acko3/dsh-ansi-render",
        "@ch4acko3/dsh-code-frame-render",
        "@ch4acko3/dsh-diff-engine",
        "@ch4acko3/dsh-diff-render",
        "@ch4acko3/dsh-markdown-render",
        "@ch4acko3/dsh-math-render",
        "@ch4acko3/dsh-mermaid-render",
        "@ch4acko3/dsh-shiki",
        "@ch4acko3/dsh-structured-render",
        "@ch4acko3/dsh-syntax-highlight",
        "@ch4acko3/dsh-table-render",
        "@ch4acko3/dsh-code-render"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.8",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.8",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@ch4acko3/dsh-ansi-render": "workspace:*",
    "@ch4acko3/dsh-code-frame-render": "workspace:*",
    "@ch4acko3/dsh-code-render": "workspace:*",
    "@ch4acko3/dsh-diff-engine": "workspace:*",
    "@ch4acko3/dsh-diff-render": "workspace:*",
    "@ch4acko3/dsh-markdown-render": "workspace:*",
    "@ch4acko3/dsh-math-render": "workspace:*",
    "@ch4acko3/dsh-mermaid-render": "workspace:*",
    "@ch4acko3/dsh-shiki": "workspace:*",
    "@ch4acko3/dsh-structured-render": "workspace:*",
    "@ch4acko3/dsh-syntax-highlight": "workspace:*",
    "@ch4acko3/dsh-table-render": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.8",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.8",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "license": "MIT"
}
