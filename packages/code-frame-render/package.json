{
  "name": "@ch4acko3/dsh-code-frame-render",
  "version": "0.1.1",
  "description": "Syntax-highlighted diagnostic code frame rendering service for DeepSeek Harness Web plugins",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run build:client && pnpm run build:host",
    "build:client": "tsdown --config-loader unrun && tsc -p tsconfig.client.build.json",
    "build:host": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": "^22.22.3 || >=24.11.1"
  },
  "dsh": {
    "plugin": {
      "schemaVersion": 1,
      "displayName": {
        "en": "Code Frame Render",
        "zh-CN": "代码诊断框渲染"
      },
      "summary": {
        "en": "Renders syntax-highlighted source context with diagnostic ranges and messages.",
        "zh-CN": "渲染带语法高亮、诊断范围和消息的源码上下文。"
      },
      "category": "development"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@ch4acko3/dsh-syntax-highlight"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.8"
  },
  "dependencies": {
    "@ch4acko3/dsh-syntax-highlight": "workspace:^"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "code-frame",
    "diagnostics",
    "syntax-highlighting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CH4ACKO3/dsh-render-engine.git",
    "directory": "packages/code-frame-render"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
