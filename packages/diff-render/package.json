{
  "name": "@ch4acko3/dsh-diff-render",
  "version": "0.1.0",
  "description": "Syntax-highlighted HTML diff rendering service for DeepSeek Harness Web plugins",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run build:client && pnpm run build:host",
    "build:client": "tsdown --config-loader unrun && tsc -p tsconfig.client.build.json",
    "build:host": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": "^22.22.3 || >=24.11.1"
  },
  "dsh": {
    "plugin": {
      "schemaVersion": 1,
      "displayName": {
        "en": "Diff Render",
        "zh-CN": "Diff 渲染"
      },
      "summary": {
        "en": "Renders normalized diffs as escaped, theme-aware HTML with source-language highlighting.",
        "zh-CN": "将归一化 Diff 渲染为经过转义、响应主题并带源码语法高亮的 HTML。"
      },
      "category": "development"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@ch4acko3/dsh-diff-engine",
        "@ch4acko3/dsh-syntax-highlight"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.8"
  },
  "dependencies": {
    "@ch4acko3/dsh-diff-engine": "workspace:^",
    "@ch4acko3/dsh-syntax-highlight": "workspace:^"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "diff",
    "diff-rendering",
    "syntax-highlighting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CH4ACKO3/dsh-render-engine.git",
    "directory": "packages/diff-render"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
