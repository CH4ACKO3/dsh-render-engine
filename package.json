{
  "name": "@ch4acko3/dsh-render-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for the DSH Shiki, syntax highlighting, and code rendering plugins",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "check": "pnpm run build && pnpm run typecheck && pnpm run test"
  },
  "engines": {
    "node": "^22.22.3 || >=24.11.1"
  },
  "packageManager": "pnpm@11.19.0",
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.8",
    "@types/node": "^24.10.0",
    "tsdown": "0.22.14",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1"
  },
  "license": "MIT"
}
